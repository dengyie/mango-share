---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/base';
import Icon from '../components/Icon.astro';
---

<Base title="页面不存在" noindex={true}>
  <header class="page-header">
    <p class="kicker">404</p>
    <h1 class="page-title">这一页走丢了</h1>
    <p class="page-desc">链接可能已经失效，或者从未存在过。</p>
    <div class="btns">
      <a class="btn primary" href={withBase('/')}>
        回到首页
        <Icon name="arrow-right" size={14} />
      </a>
      <a class="btn" href={withBase('/posts/')}>看看文章</a>
    </div>
  </header>
</Base>