---
import type { IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  label?: string;
  class?: string;
}

const { name, size = 18, strokeWidth = 1.8, label, class: className } = Astro.props;
const icons: Record<IconName, string> = {
  'arrow-left': '<path d="m15 6-6 6 6 6"/>',
