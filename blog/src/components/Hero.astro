---
// 首页头部：头像 + 问候 + 终端打字 + 数据条（数据在构建时算出）
import { SITE } from '../site.config';
import { withBase } from '../lib/base';
import { getStats } from '../lib/github';
import { getPosts } from '../lib/posts';
import Icon from './Icon.astro';

const [stats, posts] = await Promise.all([getStats(), getPosts()]);
const github = `https://github.com/${SITE.github}`;
const items = [
  { value: stats.repos, label: '原创开源项目', href: withBase('/projects/') },
  { value: stats.stars, label: '获得 Star', href: github },
  { value: posts.length, label: '篇技术笔记', href: withBase('/posts/') },
  { value: stats.years ?? '—', label: '年 GitHub 龄', href: github },
];
---

<section class="hero-band">
  <div class="container">
    <div class="hero">
      <img class="avatar" src={SITE.avatar} alt={`${SITE.author} 的头像`} width="132" height="132" />
      <div class="hero-body">
        <p class="kicker">{SITE.title} · 技术笔记 & 开源项目</p>
        <h1 class="hero-title" set:html={SITE.greeting} />
        <p class="hero-bio">{SITE.bio}</p>
        <div class="term">
          <span class="prompt">$</span> whoami<br />
          <span class="typed" data-lines={JSON.stringify(SITE.typing)}>{SITE.typing[0]}</span><span
            class="cursor"
            aria-hidden="true"></span>
        </div>
        <div class="btns">
          <a class="btn primary" href="#featured">看看我的项目</a>
          <a class="btn" href={withBase('/posts/')}>读读笔记</a>
          <a class="btn" href={github}>
            <Icon name="brand-github" size={16} /> GitHub
            <Icon name="external-link" size={13} class="btn-ext" />
          </a>
        </div>
      </div>
    </div>

    <ul class="stats">
      {
        items.map((item) => (
          <li>
            <a class="stat" href={item.href}>
              <b>
                {typeof item.value === 'number' ? (
                  <animated-counter target={item.value} duration="1200">
                    {item.value}
                  </animated-counter>
                ) : (
                  item.value
                )}
              </b>
              <small>{item.label}</small>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script is:inline>
  // 终端打字效果。关掉 JS 或开启「减少动态效果」时，停在第一句
  (function () {
    var el = document.querySelector('.typed');
    if (!el || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var lines = JSON.parse(el.dataset.lines).map(function (s) { return Array.from(s); });
    var li = 0, ci = lines[0].length, del = true;
    function tick() {
      var s = lines[li];
      el.textContent = s.slice(0, ci).join('');
      if (del) {
        if (ci > 0) { ci--; setTimeout(tick, 35); }
        else { del = false; li = (li + 1) % lines.length; setTimeout(tick, 300); }
      } else if (ci < s.length) { ci++; setTimeout(tick, 80); }
      else { del = true; setTimeout(tick, 1800); }
    }
    setTimeout(tick, 2200);
  })();
</script>

<script is:inline>
  // AnimatedCounter（awesome-ui-kit vanilla 移植版，裁剪到博客需要的最小面）：
  // SSR 已渲染最终值作为回退；JS 可用时从 0 缓动到目标值。
  // 「减少动态效果」或无 IntersectionObserver 时保持构建时数值，不动画。
  (function () {
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || typeof IntersectionObserver === 'undefined' || !window.requestAnimationFrame) return;
    function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }
    function animate(el) {
      var target = parseFloat(el.getAttribute('target'));
      var duration = parseFloat(el.getAttribute('duration') || '1200');
      if (isNaN(target)) return;
      var startTime = performance.now();
      function tick(now) {
        var progress = Math.min(1, Math.max(0, (now - startTime) / duration));
        el.textContent = String(Math.round(easeOutCubic(progress) * target));
        if (progress < 1) requestAnimationFrame(tick);
        else el.textContent = String(target);
      }
      requestAnimationFrame(tick);
    }
    customElements.define(
      'animated-counter',
      class extends HTMLElement {
        connectedCallback() {
          if (this._seen) return;
          this._seen = true;
          var self = this;
          new IntersectionObserver(function (entries, obs) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              obs.disconnect();
              animate(self);
            });
          }, { threshold: 0.2 }).observe(this);
        }
      }
    );
  })();
</script>