---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site.config';
import { withBase } from '../lib/base';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** narrow：阅读宽度（默认，文章/标签/关于）；wide：卡片网格（项目页）；full：通栏分段（首页） */
  width?: 'narrow' | 'wide' | 'full';
  /** 是否禁止搜索引擎索引（如 404 页面） */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  publishedTime,
  modifiedTime,
  width = 'narrow',
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : `${SITE.author} · ${SITE.title}`;
// Astro 7 静态构建中 Astro.url.pathname 已含 base 前缀（/blog/...），直接拼 SITE.url
const canonical = new URL(Astro.url.pathname, SITE.url);
const publishedIso = publishedTime?.toISOString();
const modifiedIso = modifiedTime?.toISOString() ?? publishedIso;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href={withBase('/icon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={withBase('/rss.xml')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta name="theme-color" content="#0b0d10" />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:image" content={SITE.avatar} />
    <meta property="og:image:alt" content={`${SITE.author} 的头像`} />
    <meta name="twitter:card" content="summary" />
    <meta name="author" content={SITE.author} />
    {type === 'article' && publishedIso && <meta property="article:published_time" content={publishedIso} />}
    {type === 'article' && modifiedIso && <meta property="article:modified_time" content={modifiedIso} />}
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // 默认暗色；用户手动切换过就记住
      try {
        var t = localStorage.getItem('theme') || 'dark';
        document.documentElement.dataset.theme = t;
        if (t === 'light') {
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', '#faf8f4');
        }
      } catch {
        document.documentElement.dataset.theme = 'dark';
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <Header />
    <main id="main" class:list={['main', width === 'full' ? 'full' : 'container']}>
      {
        width === 'narrow' ? (
          <div class="narrow">
            <slot />
          </div>
        ) : (
          <slot />
        )
      }
    </main>
    <Footer />
  </body>
</html>